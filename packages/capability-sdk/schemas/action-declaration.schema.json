{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structile.dev/schemas/action-declaration.schema.json",
  "title": "Structile declared action (ACT-001)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "input",
    "output",
    "permissions",
    "scope",
    "risk",
    "preview",
    "idempotency",
    "concurrency",
    "maxBatchSize",
    "mode",
    "timeoutMs",
    "retry",
    "audit",
    "redaction"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 1
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "input": {
      "type": "object"
    },
    "output": {
      "type": "object"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "enum": [
              "resource",
              "record"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "risk": {
      "enum": [
        "normal",
        "destructive",
        "bulk",
        "high-impact"
      ]
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "effectSummary"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "effectSummary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyRule",
        "windowSeconds"
      ],
      "properties": {
        "keyRule": {
          "enum": [
            "client-supplied",
            "derived"
          ]
        },
        "windowSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optimisticToken"
      ],
      "properties": {
        "optimisticToken": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_]*$"
        }
      }
    },
    "maxBatchSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "mode": {
      "enum": [
        "sync",
        "async"
      ]
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification"
      ],
      "properties": {
        "classification": {
          "enum": [
            "retryable",
            "non-retryable"
          ]
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
