{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structile.dev/schemas/page.schema.json",
  "title": "Structile page specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","path","nodes"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"},
    "path": {"type":"string","pattern":"^/[A-Za-z0-9\\-/]*$"},
    "titleKey": {"type":"string"},
    "nodes": {"type":"array","items":{"$ref":"https://structile.dev/schemas/node.schema.json"}}
  }
}
