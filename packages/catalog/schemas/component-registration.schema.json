{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structile.dev/schemas/component-registration.schema.json",
  "title": "Structile component registration (DS-003)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","version","props","slots","states","accessibility","dataNeeds","permissions","cost"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"},
    "version": {"type":"object","additionalProperties":false,"required":["major","minor"],
      "properties":{"major":{"type":"integer","minimum":1},"minor":{"type":"integer","minimum":0}}},
    "props": {"type":"object","additionalProperties":false,"required":["type","additionalProperties","properties"],
      "properties":{"type":{"const":"object"},"additionalProperties":{"const":false},
        "properties":{"type":"object"},"required":{"type":"array","items":{"type":"string"}}}},
    "slots": {"type":"array","maxItems":16,"items":{"type":"object","additionalProperties":false,
      "required":["name","maxChildren"],
      "properties":{"name":{"type":"string","pattern":"^[a-z][a-zA-Z0-9]*$"},
        "maxChildren":{"type":"integer","minimum":0,"maximum":256},
        "accepts":{"type":"array","items":{"type":"string"}}}}},
    "states": {"type":"array","minItems":1,"uniqueItems":true,
      "items":{"enum":["loading","empty","forbidden","error","ready"]}},
    "accessibility": {"type":"object","additionalProperties":false,
      "required":["role","keyboard","focusOrder","labelledBy"],
      "properties":{"role":{"type":"string","minLength":1},"keyboard":{"type":"string","minLength":1},
        "focusOrder":{"enum":["dom","managed"]},"labelledBy":{"type":"string","minLength":1}}},
    "dataNeeds": {"type":"array","items":{"type":"object","additionalProperties":false,
      "required":["resource","fields"],
      "properties":{"resource":{"type":"string","minLength":1},
        "fields":{"type":"array","items":{"type":"string","pattern":"^[a-z][a-zA-Z0-9_]*$"}}}}},
    "permissions": {"type":"array","items":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"}},
    "cost": {"type":"object","additionalProperties":false,"required":["staticWeight","maxRows"],
      "properties":{"staticWeight":{"type":"number","minimum":0,"maximum":100},
        "maxRows":{"type":"integer","minimum":0,"maximum":10000}}}
  }
}
